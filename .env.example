# MongoDB (required on Vercel for runtime — not used during `next build`)
# In Atlas: Database → Connect → Drivers → copy the full mongodb+srv://... string.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB_NAME=rankingpost
# Use MONGODB_URI only. (MONO_URI is a legacy alias in code — do not rely on a typo.)
# Remove duplicate env vars in Vercel; redeploy after changing secrets.
# Local-only Windows/antivirus workarounds (do NOT set on Vercel)
# MONGODB_TLS_ALLOW_INVALID_CERTS=true
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT signing secret (required in production)
AUTH_SECRET=your-random-secret-here

# Super admin account (created/updated automatically on login)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-password
SUPER_ADMIN_NAME=Super Admin

# Set to "true" to sync super admin password from env on each login
# SUPER_ADMIN_SYNC_PASSWORD=true
